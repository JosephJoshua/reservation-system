{
	email {$ACME_EMAIL}
}

(site) {
	encode zstd gzip
	# The largest upload is an invoice PDF of up to 10MB; lesson photos are up to 5MB.
	request_body {
		max_size 12MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$APP_DOMAIN} {
	import site
	# Hold requests for a few seconds while the app container restarts during a deploy.
	reverse_proxy app:8787 {
		lb_try_duration 15s
	}
}

{$STAGING_DOMAIN} {
	import site
	reverse_proxy app-staging:8787 {
		lb_try_duration 15s
	}
}
