# /srv/rs/.env: settings for compose and rs.sh. rs.sh writes the *_TAG lines itself.
APP_DOMAIN=app.example.cn
STAGING_DOMAIN=staging.example.cn
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com

# caddy (default) serves HTTPS for the domains above. external: the server already runs a reverse
# proxy such as nginx; rs.sh then leaves Caddy off and the proxy forwards to these local ports.
PROXY=caddy
APP_PORT=8787
STAGING_PORT=8788

# Package sources for image builds on a mainland server.
NPM_REGISTRY=https://registry.npmmirror.com
# Optional base image overrides, when the Docker mirror is not enough.
NODE_IMAGE=
RCLONE_IMAGE=

APP_TAG=
APP_PREV_TAG=
STAGING_TAG=
