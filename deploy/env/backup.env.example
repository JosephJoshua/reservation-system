# /srv/rs/backup.env: nightly backups of production to COS. chmod 600.
COS_BUCKET=rs-backup-1250000000
# A CAM sub-user that can only read and write this bucket.
RCLONE_CONFIG_COS_TYPE=s3
RCLONE_CONFIG_COS_PROVIDER=TencentCOS
RCLONE_CONFIG_COS_ENDPOINT=cos.ap-guangzhou.myqcloud.com
RCLONE_CONFIG_COS_ACCESS_KEY_ID=
RCLONE_CONFIG_COS_SECRET_ACCESS_KEY=
# Venue time of the nightly run, and how long copies are kept.
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=30
# BACKUP_ALLOW_REMOVALS stays unset here: rs.sh backup --allow-removals sets it for one run.
# Optional: a WeCom (企业微信) group robot webhook that hears about failed backups. Set it in
# prod.env too, to hear when backups stop.
ALERT_WEBHOOK=
# Optional: COS encrypts each copy at rest (or turn on the bucket's 默认加密 in the console).
RCLONE_CONFIG_COS_SERVER_SIDE_ENCRYPTION=
# Optional, recommended: encrypt copies before upload. Keep this key outside the server and COS:
# without it no copy can be restored. See "Encrypted backups" in deploy/README.md.
BACKUP_CRYPT_PASSWORD=
