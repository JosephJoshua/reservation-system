# /srv/rs/staging.env: staging app, with its own database. chmod 600.
# WECHAT_APP_SECRET is required: without it the API uses a development login that lets anyone
# act as any student, and rs.sh refuses to start staging.
# Until the WeChat Pay merchant account exists, leave NODE_ENV=staging and the pay lines empty:
# staging then uses the fake payment gateway, where a signed-in user can mark their own staging
# orders paid. After that, copy the pay lines from prod.env, set NODE_ENV=production, and test
# with ¥0.01 prices.
NODE_ENV=staging
# Password of the first admin login, username admin. Only read while there is no staff login yet.
ADMIN_PASSWORD=

WECHAT_APPID=wxdbd449e2acaada82
WECHAT_APP_SECRET=
# Optional: the 扫普通链接二维码 check file, as name.txt=content
WECHAT_LINK_CHECK=
# Optional: 腾讯位置服务 key for the admin's map picker (地图坐标 → 在地图上选点)
TENCENT_MAP_KEY=

PUBLIC_BASE_URL=https://staging.example.cn

# Messages tapped on staging open the trial build (体验版) of the mini program.
WECHAT_MINIPROGRAM_STATE=trial
WECHAT_NOTICE_COACH_BOOKED=
WECHAT_NOTICE_COACH_CANCELLED=
WECHAT_NOTICE_COACH_MOVED=
WECHAT_NOTICE_STUDENT_BOOKED=
WECHAT_NOTICE_STUDENT_CANCELLED=
WECHAT_NOTICE_STUDENT_REMINDER=
WECHAT_NOTICE_STUDENT_MOVED=
WECHAT_NOTICE_STUDENT_FEEDBACK=
WECHAT_NOTICE_STUDENT_PACKAGE=
