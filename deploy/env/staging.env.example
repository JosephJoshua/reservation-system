# /srv/rs/staging.env: staging app, with its own database. chmod 600.
# Until the WeChat Pay merchant account exists, leave NODE_ENV=staging and the pay lines empty:
# staging then uses the fake payment gateway. After that, copy the pay lines from prod.env, set
# NODE_ENV=production and PUBLIC_BASE_URL to the staging domain, and test with ¥0.01 prices.
NODE_ENV=staging
ADMIN_PASSWORD=

WECHAT_APPID=wxb8dc89b45d422bf1
WECHAT_APP_SECRET=

PUBLIC_BASE_URL=https://staging.example.cn

# Messages tapped on staging open the trial build (体验版) of the mini program.
WECHAT_MINIPROGRAM_STATE=trial
WECHAT_NOTICE_COACH_BOOKED=
WECHAT_NOTICE_COACH_CANCELLED=
