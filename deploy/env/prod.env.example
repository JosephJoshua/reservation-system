# /srv/rs/prod.env: production app. chmod 600. Every variable is described in deploy/README.md.
# Password of the first admin login, username admin. Only read while there is no staff login yet.
ADMIN_PASSWORD=

WECHAT_APPID=wxdbd449e2acaada82
WECHAT_APP_SECRET=
# Optional: the 扫普通链接二维码 check file, as name.txt=content
WECHAT_LINK_CHECK=
# Optional: 腾讯位置服务 key for the admin's map picker (地图坐标 → 在地图上选点)
TENCENT_MAP_KEY=

PUBLIC_BASE_URL=https://app.example.cn
WECHAT_PAY_MCHID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_MERCHANT_PRIVATE_KEY=/secrets/apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY=/secrets/pub_key.pem
WECHAT_PAY_PUBLIC_KEY_ID=

# Optional: the WeCom robot from backup.env, told when no backup has succeeded for 36 hours.
ALERT_WEBHOOK=

WECHAT_MINIPROGRAM_STATE=formal
WECHAT_NOTICE_COACH_BOOKED=
WECHAT_NOTICE_COACH_CANCELLED=
WECHAT_NOTICE_COACH_MOVED=
WECHAT_NOTICE_STUDENT_BOOKED=
WECHAT_NOTICE_STUDENT_CANCELLED=
WECHAT_NOTICE_STUDENT_REMINDER=
WECHAT_NOTICE_STUDENT_MOVED=
WECHAT_NOTICE_STUDENT_FEEDBACK=
WECHAT_NOTICE_STUDENT_PACKAGE=
