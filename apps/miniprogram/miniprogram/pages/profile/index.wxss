.me {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  background-color: var(--td-bg-color-container);
}

.me-hover {
  background-color: var(--td-bg-color-container-active);
}

.me-text {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.me-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
}

.me-phone {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
}

.me-arrow {
  display: flex;
  color: var(--td-text-color-placeholder);
}

.group {
  margin-top: 24rpx;
}

.coach-entry {
  display: flex;
  justify-content: center;
  padding: 48rpx 0 calc(48rpx + env(safe-area-inset-bottom));
}

/* Quiet, but still a 44px tap target. */
.coach-link {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  color: var(--td-text-color-placeholder);
}
