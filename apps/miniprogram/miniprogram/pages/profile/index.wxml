<theme-root>
<view class="me" hover-class="me-hover" bind:tap="editProfile">
  <t-avatar icon="user" size="112rpx" />
  <view class="me-text">
    <block wx:if="{{meLoaded}}">
      <view class="me-name">{{name || '未填写姓名'}}</view>
      <view class="me-phone">{{phone || '填写手机号，便于场馆联系'}}</view>
      <view wx:if="{{studentNo}}" class="me-no">学员编号 {{studentNo}}</view>
    </block>
    <block wx:elif="{{meFailed}}">
      <view class="me-name">资料加载失败</view>
      <view class="me-phone">请检查网络后下拉刷新</view>
    </block>
  </view>
  <view class="me-arrow"><t-icon name="chevron-right" size="40rpx" /></view>
</view>

<view wx:if="{{isCoach}}" class="group">
  <t-cell-group theme="card">
    <t-cell title="教练工作台" left-icon="calendar-event" arrow hover bind:click="openCoach" />
  </t-cell-group>
</view>

<view class="group">
  <t-cell-group theme="card">
    <t-cell title="我的课时包" note="{{remaining}}" left-icon="wallet" arrow hover bind:click="openMyPackages" />
    <t-cell title="学习记录" left-icon="chat" arrow hover bind:click="openFeedback" />
    <t-cell wx:if="{{packagesEnabled}}" title="购买课时包" left-icon="shop" arrow hover bind:click="openPackages" />
    <t-cell title="发票" left-icon="bill" arrow hover bind:click="openInvoices" />
    <t-cell title="同步前台记录" left-icon="link" arrow hover bind:click="openLink" />
  </t-cell-group>
</view>

<view class="group">
  <t-cell-group theme="card">
    <t-cell wx:if="{{venue.address}}" title="场馆地址" description="{{venue.address}}" t-class-description="address" left-icon="location" arrow hover bind:click="openMap" />
    <t-cell wx:if="{{venue.phone}}" title="联系场馆" note="{{venue.phone}}" left-icon="call" arrow hover bind:click="call" />
    <button class="cell-button" hover-class="none" open-type="contact">
      <t-cell title="联系客服" left-icon="service" arrow hover />
    </button>
  </t-cell-group>
</view>

<view class="group">
  <t-cell-group theme="card">
    <t-cell title="外观" note="{{themeLabel}}" left-icon="mode-dark" arrow hover bind:click="openTheme" />
  </t-cell-group>
</view>

<view class="group">
  <t-cell-group theme="card">
    <t-cell wx:if="{{hasBookingPolicy}}" title="预约须知" left-icon="file" arrow hover data-kind="booking" bind:click="openPolicy" />
    <t-cell title="用户协议" left-icon="file-safety" arrow hover data-kind="agreement" bind:click="openPolicy" />
    <t-cell title="隐私政策" left-icon="secured" arrow hover data-kind="privacy" bind:click="openPolicy" />
  </t-cell-group>
</view>

<view wx:if="{{meLoaded && !isCoach}}" class="coach-entry">
  <text class="coach-link" bind:tap="openCoach">教练入口</text>
</view>
<privacy-popup id="privacy-popup" />
</theme-root>
