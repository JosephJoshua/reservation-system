<view wx:if="{{state === 'loading'}}" class="centered">
  <t-loading theme="circular" size="48rpx" />
</view>

<view wx:elif="{{state === 'error'}}" class="centered">
  <view>
    <t-empty icon="{{errorIcon}}" description="{{error}}" />
    <view class="retry"><t-button theme="primary" variant="outline" bind:tap="retry">重新加载</t-button></view>
  </view>
</view>

<view wx:else class="has-action-bar">
  <view class="summary card">
    <view class="summary-name">{{lessonName}}</view>
    <view class="summary-when">{{when}}</view>
    <view class="coach">
      <t-avatar image="{{coachAvatar}}" icon="{{coachAvatar ? '' : 'user'}}" size="72rpx" />
      <view class="coach-text">
        <view class="coach-name">{{coachName}}</view>
        <view wx:if="{{coachTitle}}" class="coach-title">{{coachTitle}}</view>
      </view>
      <view class="muted duration">{{duration}} 分钟</view>
    </view>
  </view>

  <view class="section-title">支付方式</view>
  <view class="card">
    <view wx:if="{{pkg}}" class="option" bind:tap="choosePackage">
      <view class="option-icon"><t-icon name="wallet" size="44rpx" /></view>
      <view class="option-text">
        <view class="option-title">使用课时包</view>
        <view class="option-desc">{{pkg.name}}，剩余 {{pkg.remaining}} 节</view>
      </view>
      <view class="{{payWith === 'package' ? 'checked' : 'unchecked'}}"><t-icon name="{{payWith === 'package' ? 'check-circle-filled' : 'circle'}}" size="44rpx" /></view>
    </view>
    <view wx:if="{{perClassEnabled}}" class="option" bind:tap="chooseWechat">
      <view class="option-icon wechat"><t-icon name="logo-wechatpay-filled" size="44rpx" /></view>
      <view class="option-text">
        <view class="option-title">微信支付</view>
        <view class="option-desc">
          <text>{{priceText}}</text>
          <text wx:if="{{originalText}}" class="price-original">{{originalText}}</text>
        </view>
      </view>
      <view class="{{payWith === 'wechat' ? 'checked' : 'unchecked'}}"><t-icon name="{{payWith === 'wechat' ? 'check-circle-filled' : 'circle'}}" size="44rpx" /></view>
    </view>
    <view wx:if="{{!pkg && !perClassEnabled}}" class="option" bind:tap="openPackages">
      <view class="option-icon"><t-icon name="wallet" size="44rpx" /></view>
      <view class="option-text">
        <view class="option-title">这门课需使用课时包</view>
        <view class="option-desc">购买后即可预约</view>
      </view>
      <view class="unchecked"><t-icon name="chevron-right" size="40rpx" /></view>
    </view>
  </view>

  <block wx:if="{{needName || needPhone}}">
    <view class="section-title">联系方式（仅场馆可见）</view>
    <t-cell-group theme="card">
      <t-input wx:if="{{needName}}" label="姓名" placeholder="上课学员姓名" maxlength="{{20}}" value="{{name}}" bind:change="onName" />
      <t-input wx:if="{{needPhone}}" label="手机号" placeholder="用于课程变动通知" type="number" maxlength="{{11}}" value="{{phone}}" bind:change="onPhone" />
    </t-cell-group>
  </block>

  <view class="footnote">
    <view>{{cancelRule}}</view>
    <view wx:if="{{hasPolicies && !showAgreement}}" class="links">
      <text class="link" data-kind="booking" bind:tap="openPolicy">预约须知</text>
    </view>
  </view>

  <view wx:if="{{showAgreement}}" class="agree" bind:tap="toggleAgree">
    <view class="{{agreed ? 'checked' : 'unchecked'}}"><t-icon name="{{agreed ? 'check-circle-filled' : 'circle'}}" size="36rpx" /></view>
    <view class="agree-text">
      我已阅读并同意<text class="link" data-kind="agreement" catch:tap="openPolicy">《用户协议》</text>和<text class="link" data-kind="booking" catch:tap="openPolicy">《预约须知》</text>
    </view>
  </view>

  <view class="action-bar">
    <view class="grow">
      <block wx:if="{{payWith === 'package' && pkg}}">
        <text class="total-label">课时包抵扣</text><text class="total">1 节</text>
      </block>
      <block wx:elif="{{perClassEnabled}}">
        <text class="total-label">应付</text><text class="total">{{priceText}}</text>
      </block>
    </view>
    <t-button
      theme="primary"
      size="large"
      t-class="submit"
      loading="{{submitting}}"
      disabled="{{!pkg && !perClassEnabled}}"
      bind:tap="submit"
    >{{payWith === 'wechat' && price > 0 ? '去支付' : '确认预约'}}</t-button>
  </view>
</view>
