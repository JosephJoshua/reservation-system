<theme-root>
<view wx:if="{{state === 'loading'}}" class="centered">
  <t-loading theme="circular" size="48rpx" />
</view>

<view wx:elif="{{state === 'error'}}" class="centered">
  <view>
    <t-empty icon="{{errorIcon}}" description="{{error}}" />
    <view class="retry"><t-button theme="light" bind:tap="retry">重新加载</t-button></view>
  </view>
</view>

<view wx:else class="{{booking.canCancel || booking.status === 'cancelled' || booking.status === 'expired' ? 'has-action-bar' : ''}}">
  <view class="status">
    <view class="status-icon tone-{{statusTone}}"><t-icon name="{{statusIcon}}" size="56rpx" /></view>
    <view>
      <view class="status-title">{{statusTitle}}</view>
      <view class="status-text">{{statusText}}</view>
    </view>
  </view>

  <t-cell-group theme="card">
    <t-cell title="课程" note="{{booking.lessonType.name}}" />
    <t-cell title="教练" note="{{booking.coach.name}}" />
    <t-cell title="时间" note="{{when}}" />
    <t-cell wx:if="{{movedFrom}}" title="原定时间" note="{{movedFrom}}" />
    <t-cell title="支付" note="{{payment}}" />
    <t-cell wx:if="{{refund}}" title="退款" note="{{refund}}" />
    <t-cell wx:if="{{invoice}}" title="发票" note="{{invoice}}" arrow="{{invoiceTappable}}" hover="{{invoiceTappable}}" bind:click="openInvoice" />
    <t-cell wx:if="{{booking.status === 'confirmed' || booking.status === 'pending_payment'}}" title="免费取消截止" note="{{deadline}}" />
  </t-cell-group>

  <block wx:if="{{feedback}}">
    <view class="section-title">{{feedback.title}}</view>
    <view class="card feedback">
      <view class="feedback-text">{{feedback.text}}</view>
      <view wx:if="{{feedback.photos.length}}" class="photos feedback-photos">
        <view
          wx:for="{{feedback.photos}}"
          wx:key="*this"
          class="photo"
          data-index="{{index}}"
          bind:tap="previewPhoto"
        >
          <image class="photo-image" src="{{item}}" mode="aspectFill" lazy-load />
        </view>
      </view>
    </view>
  </block>

  <view class="venue">
    <t-cell-group theme="card">
      <t-cell wx:if="{{address}}" title="{{address}}" left-icon="location" arrow hover bind:click="openMap" />
      <t-cell wx:if="{{canAddToCalendar}}" title="添加到日历" left-icon="calendar" arrow hover bind:click="addToCalendar" />
      <button
        class="cell-button"
        hover-class="none"
        open-type="contact"
        show-message-card
        send-message-title="{{booking.lessonType.name}} · {{when}}"
        send-message-path="/pages/booking-detail/index?id={{booking.id}}"
      >
        <t-cell title="联系客服" left-icon="service" arrow hover />
      </button>
    </t-cell-group>
  </view>

  <view wx:if="{{booking.canCancel && cancelRule}}" class="footnote">{{cancelRule}}</view>

  <view wx:if="{{booking.status === 'pending_payment'}}" class="action-bar">
    <view class="grow">
      <t-button block t-class="action-button" theme="default" disabled="{{busy}}" bind:tap="cancel">取消预约</t-button>
    </view>
    <view class="grow">
      <t-button block t-class="action-button" theme="primary" loading="{{busy}}" bind:tap="pay">去支付</t-button>
    </view>
  </view>
  <view wx:elif="{{booking.canCancel}}" class="action-bar">
    <view class="grow">
      <t-button block t-class="action-button" theme="default" loading="{{busy}}" bind:tap="cancel">取消预约</t-button>
    </view>
    <view wx:if="{{booking.canMove}}" class="grow">
      <t-button block t-class="action-button" theme="primary" disabled="{{busy}}" bind:tap="move">改约</t-button>
    </view>
  </view>
  <view wx:elif="{{booking.status === 'cancelled' || booking.status === 'expired'}}" class="action-bar">
    <view class="grow">
      <t-button block t-class="action-button" theme="primary" bind:tap="rebook">重新预约</t-button>
    </view>
  </view>
</view>
<privacy-popup id="privacy-popup" />
</theme-root>
