@import '../../styles/common.wxss';
@import '../../styles/photos.wxss';

.status {
  display: flex;
  /* Next to the title, also when a long cancel reason runs over several lines. */
  align-items: flex-start;
  padding: 48rpx 48rpx 40rpx;
}

.status-icon {
  display: flex;
  align-items: center;
  height: 56rpx;
  margin-right: 24rpx;
}

.tone-brand {
  color: var(--td-text-color-brand);
}

.tone-hint {
  color: var(--rs-hint-color);
}

.tone-muted {
  color: var(--td-text-color-placeholder);
}

.status-title {
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
}

.status-text {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
}

.venue {
  margin-top: 24rpx;
}

.retry {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}

/* A long note wraps instead of squeezing the row label. */
.label {
  flex: none;
  white-space: nowrap;
}
