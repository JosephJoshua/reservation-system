<theme-root>
<view class="group">
  <t-cell-group theme="card">
    <t-cell
      wx:for="{{options}}"
      wx:key="value"
      title="{{item.label}}"
      hover
      data-value="{{item.value}}"
      bind:click="choose"
    >
      <t-icon wx:if="{{item.value === setting}}" slot="note" name="check" size="44rpx" color="var(--td-text-color-brand)" />
    </t-cell>
  </t-cell-group>
</view>
<view class="footnote">选择跟随系统时，会随手机的深色模式自动切换。系统弹窗始终跟随手机的设置。</view>
</theme-root>
