<theme-root>
<view wx:if="{{state === 'loading'}}" class="centered">
  <t-loading theme="circular" size="48rpx" />
</view>

<view wx:elif="{{state === 'error'}}" class="centered">
  <view>
    <t-empty icon="{{errorIcon}}" description="{{error}}" />
    <view class="retry"><t-button theme="light" bind:tap="retry">重新加载</t-button></view>
  </view>
</view>

<view wx:else>
  <view class="header">
    <view class="section-title first">教练</view>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" scroll-with-animation scroll-into-view="{{coachAnchor}}" class="coach-scroll">
      <view id="coach-start" class="day-start" />
      <view class="coach-row">
        <view
          wx:if="{{coaches.length > 1}}"
          class="coach {{coachId === 0 ? 'coach-active' : ''}}"
          data-id="{{0}}"
          bind:tap="pickCoach"
        >
          <view class="coach-any">全部</view>
          <view class="coach-name">不限教练</view>
        </view>
        <view
          wx:for="{{coaches}}"
          wx:key="id"
          id="coach-{{item.id}}"
          class="coach {{coachId === item.id ? 'coach-active' : ''}}"
          data-id="{{item.id}}"
          bind:tap="pickCoach"
        >
          <t-avatar image="{{item.avatar}}" icon="{{item.avatar ? '' : 'user'}}" size="88rpx" />
          <view class="coach-name">{{item.name}}</view>
          <view class="coach-price">
            <text>{{item.price}}</text>
            <text wx:if="{{item.original}}" class="price-original">{{item.original}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
    <view wx:if="{{picked}}" class="coach-info" hover-class="coach-info-hover" data-id="{{picked.id}}" bind:tap="openCoach">
      <view wx:if="{{picked.category}}" class="coach-info-tag">
        <t-tag size="small" theme="primary" variant="light">{{picked.category}}</t-tag>
      </view>
      <text class="coach-info-title">{{picked.title || picked.name}}</text>
      <text class="coach-info-link">教练介绍</text>
      <t-icon name="chevron-right" size="32rpx" />
    </view>
    <view wx:elif="{{coaches.length > 1}}" class="coach-info" hover-class="coach-info-hover" bind:tap="showCoaches">
      <text class="coach-info-title">{{coaches.length}} 位教练可选</text>
      <text class="coach-info-link">教练介绍</text>
      <t-icon name="chevron-right" size="32rpx" />
    </view>

    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" scroll-with-animation scroll-into-view="{{dayAnchor}}" class="day-scroll">
      <view id="day-start" class="day-start" />
      <view class="day-row">
        <view
          wx:for="{{days}}"
          wx:key="key"
          id="day-{{item.key}}"
          class="day {{date === item.key ? 'day-active' : ''}}"
          data-key="{{item.key}}"
          bind:tap="pickDate"
        >
          <view class="day-label">{{item.label}}</view>
          <view class="day-date">{{item.date}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{slotsState === 'loading'}}" class="slots-status">
    <t-loading theme="circular" size="40rpx" />
  </view>
  <view wx:elif="{{slotsState === 'error'}}" class="slots-status muted">
    {{error}}
  </view>
  <view wx:elif="{{!slots.length}}" class="slots-empty">
    <t-empty icon="{{emptyIcon}}" description="{{capacity > 1 ? '这一天没有排课' : '这一天没有可预约的时段'}}" />
  </view>
  <view wx:else>
    <view wx:if="{{capacity > 1}}" class="section-title">
      {{availableCount ? '可报名 ' + availableCount + ' 节，每节 ' + duration + ' 分钟' : '这一天已无可报名的课'}}
    </view>
    <view wx:else class="section-title">
      {{availableCount ? '可预约 ' + availableCount + ' 个时段，每节 ' + duration + ' 分钟' : '这一天已无可约时段'}}
    </view>
    <view class="slot-grid">
      <view
        wx:for="{{slots}}"
        wx:key="id"
        class="slot {{item.available ? '' : 'slot-full'}}"
        hover-class="{{item.available ? 'slot-hover' : 'none'}}"
        data-index="{{index}}"
        bind:tap="pickSlot"
      >
        <view class="slot-time">{{item.time}}</view>
        <view wx:if="{{item.seatsLeft === null}}" class="slot-sub">{{item.available ? (coachId ? '可约' : item.coachName) : item.closed ? '已截止' : '已约满'}}</view>
        <block wx:else>
          <view wx:if="{{!coachId}}" class="slot-sub">{{item.coachName}}</view>
          <view class="slot-sub">{{item.available ? '剩 ' + item.seatsLeft + ' 位' : item.closed ? '已截止' : item.seatsLeft === 0 ? '已满员' : '已约满'}}</view>
        </block>
      </view>
    </view>
  </view>
</view>

<t-popup visible="{{coachSheet}}" placement="bottom" bind:visible-change="onCoachSheet">
  <view class="sheet">
    <view class="sheet-title">教练介绍</view>
    <scroll-view scroll-y class="sheet-list" style="{{coaches.length > 5 ? 'height: 60vh' : ''}}">
      <view
        wx:for="{{coaches}}"
        wx:key="id"
        class="sheet-coach"
        hover-class="sheet-coach-hover"
        data-id="{{item.id}}"
        bind:tap="openCoach"
      >
        <t-avatar image="{{item.avatar}}" icon="{{item.avatar ? '' : 'user'}}" size="80rpx" />
        <view class="sheet-coach-text">
          <view class="sheet-coach-name">
            <text>{{item.name}}</text>
            <view wx:if="{{item.category}}" class="coach-info-tag sheet-coach-tag">
              <t-tag size="small" theme="primary" variant="light">{{item.category}}</t-tag>
            </view>
          </view>
          <view wx:if="{{item.title}}" class="sheet-coach-title">{{item.title}}</view>
        </view>
        <view class="sheet-coach-price">
          <text>{{item.price}}</text>
          <view wx:if="{{item.original}}" class="price-original">{{item.original}}</view>
        </view>
        <view class="row-arrow"><t-icon name="chevron-right" size="40rpx" /></view>
      </view>
    </scroll-view>
  </view>
</t-popup>
</theme-root>
