<theme-root>
<view wx:if="{{state === 'loading'}}" class="centered">
  <t-loading theme="circular" size="48rpx" />
</view>

<view wx:elif="{{state === 'error'}}" class="centered">
  <view>
    <t-empty icon="{{errorIcon}}" description="{{error}}" />
    <view class="retry"><t-button theme="light" bind:tap="retry">重新加载</t-button></view>
  </view>
</view>

<block wx:else>
  <view class="form has-action-bar">
    <t-cell-group theme="card">
      <t-input label="姓名" placeholder="上课学员姓名" maxlength="{{20}}" value="{{name}}" bind:change="onName" />
      <t-input label="手机号" placeholder="用于课程变动通知" type="number" maxlength="{{11}}" value="{{phone}}" bind:change="onPhone" />
    </t-cell-group>
    <view class="footnote">仅场馆工作人员可见，用于上课联系和课程变动通知。</view>
    <agree-check id="agree-check" wx:if="{{showAgreement}}" checked="{{agreed}}" bind:change="onAgree" />
    <view class="delete-entry">
      <text class="delete-link" bind:tap="openDelete">注销账号</text>
    </view>
  </view>
  <view class="action-bar">
    <view class="grow">
      <t-button theme="primary" block t-class="action-button" loading="{{saving}}" bind:tap="save">保存</t-button>
    </view>
  </view>
</block>
</theme-root>
