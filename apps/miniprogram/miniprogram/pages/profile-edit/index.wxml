<view class="form">
  <t-cell-group theme="card">
    <t-input label="姓名" placeholder="上课学员姓名" maxlength="{{20}}" value="{{name}}" bind:change="onName" />
    <t-input label="手机号" placeholder="用于课程变动通知" type="number" maxlength="{{11}}" value="{{phone}}" bind:change="onPhone" />
  </t-cell-group>
  <view class="footnote">仅场馆工作人员可见，用于上课联系和课程变动通知。</view>
  <view class="save">
    <t-button theme="primary" size="large" block loading="{{saving}}" bind:tap="save">保存</t-button>
  </view>
</view>
