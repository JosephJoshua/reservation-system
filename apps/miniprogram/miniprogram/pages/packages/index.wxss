@import '../../styles/common.wxss';

.list {
  padding-top: 24rpx;
}

.product {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 2rpx solid transparent;
}

.product-highlight {
  border-color: var(--td-brand-color);
}

.product-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
}

.product-scope {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
}

.product-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--td-text-color-primary);
}

.product-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--td-text-color-placeholder);
}

.product-foot {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--td-component-stroke);
}

.grow {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
}

.product-price {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
}

.product-unit {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
}

.link {
  color: var(--td-text-color-link);
}

.retry {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}
