@import '../../styles/common.wxss';

.list {
  padding: 24rpx 0 48rpx;
}

.lesson {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 28rpx 32rpx;
}

.lesson-hover {
  background-color: var(--td-bg-color-container-active);
}

.date {
  width: 112rpx;
  padding-right: 24rpx;
  margin-right: 24rpx;
  border-right: 1rpx solid var(--td-component-stroke);
  text-align: center;
}

.date-day {
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
}

.date-num {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
}

.info {
  flex: 1;
  min-width: 0;
}

.info-time {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--td-text-color-primary);
}

.info-name {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.has-feedback {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--td-text-color-brand);
}

.centered {
  min-height: 60vh;
}

.retry {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}

.check-in {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
  padding: 28rpx 32rpx;
}

/* The button keeps its own width, so the lesson and coach get the rest. */
.check-in-action {
  flex: none;
}

/* 44px tap target, as WeChat asks. */
.check-in-button {
  /* t-button is a native button, which defaults to 184px wide. */
  width: auto !important;
  margin: 0 !important;
  min-height: 88rpx;
  padding: 0 32rpx !important;
}

.nowrap {
  white-space: nowrap;
}
