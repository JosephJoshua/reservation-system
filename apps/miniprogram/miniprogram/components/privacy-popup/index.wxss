.sheet {
  padding: 48rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  background-color: var(--td-bg-color-container);
  border-radius: 24rpx 24rpx 0 0;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
}

.body {
  margin-top: 24rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--td-text-color-secondary);
}

.link {
  color: var(--td-text-color-link);
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

/* Native buttons, since only a native one can carry the agree event the platform checks. */
.btn {
  flex: 1;
  width: auto !important;
  height: 88rpx;
  margin: 0;
  padding: 0;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 88rpx;
  border-radius: 12rpx;
}

.btn::after {
  border: none;
}

.btn-secondary {
  color: var(--td-text-color-primary);
  background-color: var(--td-bg-color-secondarycontainer);
}

.btn-primary {
  color: var(--td-text-color-anti);
  background-color: var(--td-brand-color);
}

.btn-hover {
  opacity: 0.7;
}
