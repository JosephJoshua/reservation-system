@import '../../styles/common.wxss';

.header {
  padding: 16rpx 0 8rpx;
  background-color: var(--td-bg-color-container);
}

.day-scroll {
  white-space: nowrap;
}

.day-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 32rpx;
}

.day {
  width: 104rpx;
  padding: 16rpx 0 12rpx;
  border-radius: 16rpx;
  text-align: center;
}

.day-label {
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
}

.day-date {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--td-text-color-primary);
}

.day-past .day-date {
  color: var(--td-text-color-secondary);
}

.day-dot {
  width: 10rpx;
  height: 10rpx;
  margin: 8rpx auto 0;
  border-radius: 50%;
  background-color: var(--td-brand-color);
}

.day-dot-none {
  background-color: transparent;
}

.day-active {
  background-color: var(--td-brand-color);
}

.day-active .day-label,
.day-active .day-date {
  color: #ffffff;
}

.day-active .day-dot {
  background-color: #ffffff;
}

.day-active .day-dot-none {
  background-color: transparent;
}

.slots-status {
  display: flex;
  justify-content: center;
  padding: 96rpx 32rpx;
  font-size: 28rpx;
}

.slots-empty {
  padding: 96rpx 0;
}

.list {
  margin-bottom: 8rpx;
}

.row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 128rpx;
  padding: 20rpx 24rpx 20rpx 32rpx;
  box-sizing: border-box;
}

.row + .row::before {
  content: '';
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 0;
  border-top: 1rpx solid var(--td-component-stroke);
}

.row-hover {
  background-color: var(--td-bg-color-container-active);
}

.row-time {
  width: 96rpx;
  flex-shrink: 0;
}

.row-start {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
}

.row-end {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
}

.row-main {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx 0 24rpx;
  border-left: 1rpx solid var(--td-component-stroke);
  margin-left: 8rpx;
}

.row-title {
  font-size: 32rpx;
  color: var(--td-text-color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-sub {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-free {
  color: var(--td-text-color-secondary);
}

.row-off .row-start,
.row-off .row-title {
  color: var(--td-text-color-placeholder);
}

.row-arrow {
  display: flex;
  margin-left: 8rpx;
  color: var(--td-text-color-placeholder);
}

.retry {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}
