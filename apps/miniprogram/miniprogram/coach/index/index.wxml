<theme-root>
<view wx:if="{{state === 'loading'}}" class="centered">
  <t-loading theme="circular" size="48rpx" />
</view>

<view wx:elif="{{state === 'error'}}" class="centered">
  <view>
    <t-empty icon="{{errorIcon}}" description="{{error}}" />
    <view class="retry"><t-button theme="primary" variant="outline" bind:tap="retry">重新加载</t-button></view>
  </view>
</view>

<view wx:else class="has-action-bar">
  <view class="header">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" scroll-into-view="{{dayAnchor}}" class="day-scroll">
      <view class="day-row">
        <view
          wx:for="{{days}}"
          wx:key="key"
          id="day-{{item.key}}"
          class="day {{date === item.key ? 'day-active' : ''}} {{item.past ? 'day-past' : ''}}"
          data-key="{{item.key}}"
          bind:tap="pickDate"
        >
          <view class="day-label">{{item.label}}</view>
          <view class="day-date">{{item.date}}</view>
          <view class="day-dot {{item.lessons ? '' : 'day-dot-none'}}" />
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{slotsState === 'error'}}" class="slots-status muted">{{error}}</view>
  <view wx:elif="{{!rows.length}}" class="slots-empty">
    <t-empty icon="{{emptyIcon}}" description="{{dayEmpty}}" />
  </view>
  <view wx:else>
    <view class="section-title">{{summary}}</view>
    <view class="card list">
      <view
        wx:for="{{rows}}"
        wx:key="key"
        class="row row-{{item.kind}}"
        hover-class="{{item.active ? 'row-hover' : 'none'}}"
        data-index="{{index}}"
        bind:tap="openRow"
      >
        <view class="row-time">
          <view class="row-start">{{item.start}}</view>
          <view class="row-end">{{item.end}}</view>
        </view>
        <view wx:if="{{item.kind === 'free'}}" class="row-main">
          <view class="row-title row-free">{{item.label}}</view>
        </view>
        <view wx:else class="row-main">
          <view class="row-title">{{item.student}}</view>
          <view wx:if="{{item.lesson}}" class="row-sub">{{item.lesson}}</view>
        </view>
        <t-tag wx:if="{{item.tag}}" size="medium" theme="{{item.tone}}" variant="light">{{item.tag}}</t-tag>
        <view wx:if="{{item.active}}" class="row-arrow"><t-icon name="chevron-right" size="40rpx" /></view>
      </view>
    </view>
    <view class="footnote">{{footnote}}</view>
  </view>

  <view class="action-bar">
    <view class="grow">
      <t-button block t-class="action-button" theme="primary" bind:tap="openHours">我的排班</t-button>
    </view>
  </view>
</view>
</theme-root>
