@import '../../styles/common.wxss';
@import '../../styles/photos.wxss';

.lesson {
  padding: 32rpx 48rpx 24rpx;
}

.lesson-student {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson-time {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
}

.editor-photos {
  padding: 0 32rpx;
}

.photo-uploading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background-color: rgba(0, 0, 0, 0.4);
}

/* 44px tap area in the corner, around a small visible dot. */
.photo-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 8rpx;
  box-sizing: border-box;
}

.photo-edit {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  padding: 8rpx;
  box-sizing: border-box;
}

.photo-remove-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #fff;
  background-color: rgba(0, 0, 0, 0.55);
  /* Keeps the dot visible on a dark photo. */
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.6);
}

.photo-add {
  background-color: var(--td-bg-color-container);
  border: 2rpx dashed var(--td-component-border);
  box-sizing: border-box;
}

.photo-add-hover {
  background-color: var(--td-bg-color-container-active);
}

.photo-add-inner {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--td-text-color-secondary);
}

.photo-add-text {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.retry {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}
