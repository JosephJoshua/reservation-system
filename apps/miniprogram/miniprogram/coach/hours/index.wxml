<view wx:if="{{state === 'loading'}}" class="centered">
  <t-loading theme="circular" size="48rpx" />
</view>

<view wx:elif="{{state === 'error'}}" class="centered">
  <view>
    <t-empty icon="{{errorIcon}}" description="{{error}}" />
    <view class="retry"><t-button theme="primary" variant="outline" bind:tap="retry">重新加载</t-button></view>
  </view>
</view>

<view wx:elif="{{!lessonMinutes.length}}" class="centered">
  <t-empty icon="{{emptyIcon}}" description="场馆还没有给你分配课程，请联系场馆" />
</view>

<view wx:else class="has-action-bar">
  <view class="section-title">每周可约时间</view>
  <view class="card">
    <view wx:for="{{week}}" wx:key="weekday" class="day" hover-class="day-hover" data-weekday="{{item.weekday}}" bind:tap="openAdd">
      <view class="day-name">{{item.name}}</view>
      <view class="day-windows">
        <view wx:if="{{!item.windows.length}}" class="day-off">不接课</view>
        <view wx:for="{{item.windows}}" wx:for-item="w" wx:key="index" class="window">
          <view class="window-text">
            <text class="window-time">{{w.time}}</text>
            <text class="window-sub">{{w.sub}}</text>
          </view>
          <view class="window-remove" data-index="{{w.index}}" catch:tap="remove">
            <t-icon name="close-circle-filled" size="40rpx" />
          </view>
        </view>
      </view>
      <view class="day-add"><t-icon name="add" size="40rpx" /></view>
    </view>
  </view>
  <view class="footnote">点某一天添加时间段。保存后自动生成未来 {{advanceDays}} 天的可约时段，已被预约的课程不受影响。</view>

  <view class="section-title">休息日</view>
  <view class="card {{daysOff.length ? 'has-days' : ''}}">
    <view wx:for="{{daysOff}}" wx:key="key" class="off">
      <text class="off-date">{{item.text}}</text>
      <view class="off-remove" data-key="{{item.key}}" bind:tap="removeDayOff">取消休息</view>
    </view>
    <picker mode="date" value="{{today}}" start="{{today}}" end="{{lastDay}}" bind:change="addDayOff">
      <view class="off off-add" hover-class="day-hover">
        <t-icon name="add" size="40rpx" />
        <text>添加休息日</text>
      </view>
    </picker>
  </view>
  <view class="footnote">休息日当天的空闲时段会关闭，立即生效。当天已有的预约需要你联系学员或在课程详情里取消。</view>

  <view class="action-bar">
    <view class="grow">
      <t-button block t-class="action-button" theme="primary" disabled="{{!dirty}}" loading="{{saving}}" bind:tap="save">保存每周时间</t-button>
    </view>
  </view>
</view>

<t-popup visible="{{adding}}" placement="bottom" bind:visible-change="onPopup">
  <view class="sheet">
    <view class="sheet-title">添加时间段 · {{addName}}</view>
    <picker mode="time" value="{{addStart}}" bind:change="onStart">
      <view class="sheet-row" hover-class="day-hover">
        <text>开始</text>
        <text class="sheet-value">{{addStart}}</text>
      </view>
    </picker>
    <picker mode="time" value="{{addEnd}}" bind:change="onEnd">
      <view class="sheet-row" hover-class="day-hover">
        <text>结束</text>
        <text class="sheet-value">{{addEnd}}</text>
      </view>
    </picker>
    <view class="sheet-row">
      <text>每节</text>
      <view class="chips">
        <view wx:for="{{lessonMinutes}}" wx:key="*this" class="chip {{addMinutes === item ? 'chip-active' : ''}}" data-minutes="{{item}}" bind:tap="onMinutes">{{item}} 分钟</view>
      </view>
    </view>
    <view class="sheet-hint {{addInvalid ? 'sheet-hint-error' : ''}}">{{addHint}}</view>
    <view class="sheet-actions">
      <t-button block t-class="action-button" theme="primary" disabled="{{addInvalid}}" bind:tap="confirmAdd">添加</t-button>
    </view>
  </view>
</t-popup>
