@import '../../styles/common.wxss';

.day {
  position: relative;
  display: flex;
  align-items: flex-start;
  min-height: 112rpx;
  padding: 28rpx 24rpx 28rpx 32rpx;
  box-sizing: border-box;
}

.day + .day::before,
.from::before,
.off + .off::before,
.has-days .off-add::before {
  content: '';
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 0;
  border-top: 1rpx solid var(--td-component-stroke);
}

.day-hover {
  background-color: var(--td-bg-color-container-active);
}

.day-name {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 32rpx;
  line-height: 56rpx;
  color: var(--td-text-color-primary);
}

.day-windows {
  flex: 1;
  min-width: 0;
}

.day-off {
  font-size: 28rpx;
  line-height: 56rpx;
  color: var(--td-text-color-secondary);
}

.window {
  display: flex;
  align-items: center;
  min-height: 56rpx;
}

.window + .window {
  margin-top: 12rpx;
}

.window-text {
  flex: 1;
  min-width: 0;
}

.window-time {
  font-size: 32rpx;
  color: var(--td-text-color-primary);
}

/* Wraps as a whole under the time when the row is too narrow, never word by word. */
.window-sub {
  display: inline-block;
  margin-left: 16rpx;
  white-space: nowrap;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
}

/* 88rpx square: a 44px tap target around a small icon. */
.window-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: -16rpx 0;
  color: var(--td-text-color-secondary);
}

.day-add {
  display: flex;
  align-items: center;
  height: 56rpx;
  margin-left: 8rpx;
  color: var(--td-text-color-brand);
}

.off {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  color: var(--td-text-color-primary);
}

.off-text {
  flex: 1;
  min-width: 0;
}

.off-part {
  display: inline-block;
  margin-right: 8rpx;
  white-space: nowrap;
}

.off-kind {
  margin-right: 16rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
}

.off-kind-extra {
  color: var(--td-text-color-brand);
}

.off-note {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* A 44px tap target. */
.off-remove {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  height: 88rpx;
  padding-left: 32rpx;
  font-size: 28rpx;
  color: var(--td-text-color-brand);
}

.off-add {
  justify-content: flex-start;
  gap: 12rpx;
  color: var(--td-text-color-brand);
}

.off-empty {
  color: var(--td-text-color-secondary);
}

.from {
  align-items: center;
}

.from-label {
  flex: 1;
  font-size: 32rpx;
  color: var(--td-text-color-primary);
}

.from-value {
  font-size: 32rpx;
  color: var(--td-text-color-brand);
}

.plan {
  position: relative;
  padding: 24rpx 32rpx;
}

.plan + .plan::before {
  content: '';
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 0;
  border-top: 1rpx solid var(--td-component-stroke);
}

.plan-date {
  font-size: 32rpx;
  color: var(--td-text-color-primary);
}

.plan-hours {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--td-text-color-secondary);
}

.plan-part,
.keep {
  display: inline-block;
  white-space: nowrap;
}

.locked {
  margin: 24rpx 32rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
  background-color: var(--td-bg-color-secondarycontainer);
}

.read-only {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.sheet-input {
  flex: 1;
  height: 112rpx;
  font-size: 32rpx;
  color: var(--td-text-color-primary);
}

.sheet {
  padding: 32rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  background-color: var(--td-bg-color-container);
  border-radius: 24rpx 24rpx 0 0;
}

.sheet-title {
  padding: 0 32rpx 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  color: var(--td-text-color-primary);
}

.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  color: var(--td-text-color-primary);
  border-top: 1rpx solid var(--td-component-stroke);
}

.sheet-value {
  color: var(--td-text-color-brand);
}

.sheet-hint {
  min-height: 40rpx;
  padding: 8rpx 32rpx 24rpx;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
}

.sheet-actions {
  padding: 0 32rpx;
}

.retry {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}

.sheet-hint-error {
  color: var(--rs-error-text-color);
}
