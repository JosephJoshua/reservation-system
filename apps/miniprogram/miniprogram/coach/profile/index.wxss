@import '../../styles/common.wxss';

.lesson {
  padding: 32rpx 48rpx 24rpx;
}

.lesson-student {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson-time {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx 32rpx 8rpx;
}

/* A whole chip removes the tag, 44px tall so it is easy to hit. */
.tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--td-text-color-primary);
  background-color: var(--td-bg-color-secondarycontainer);
}

.tag-text {
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.retry {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}
