<theme-root>
<view class="has-action-bar">
  <view class="intro">
    <view class="intro-icon"><t-icon name="user-checked" size="96rpx" /></view>
    <view class="intro-title">绑定教练账号</view>
    <view class="intro-text">向场馆获取 8 位绑定码，绑定后可在这里查看课表、签到和设置可约时间。</view>
  </view>
  <t-cell-group theme="card">
    <t-input label="绑定码" placeholder="8 位字母或数字" maxlength="{{9}}" value="{{code}}" confirm-type="done" bind:change="onCode" bind:enter="submit" />
  </t-cell-group>
  <view class="footnote">绑定码 24 小时内有效，只能用一次。</view>
</view>
<view class="action-bar">
  <view class="grow">
    <t-button theme="primary" block t-class="action-button" disabled="{{code.length < 8}}" loading="{{binding}}" bind:tap="submit">绑定</t-button>
  </view>
</view>
</theme-root>
