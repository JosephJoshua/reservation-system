@import '../../styles/common.wxss';
@import '../../styles/photos.wxss';

.status {
  display: flex;
  align-items: center;
  padding: 40rpx 48rpx 32rpx;
}

.status-text-block {
  flex: 1;
  min-width: 0;
}

.status-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-text {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
}

.attendance {
  display: flex;
  gap: 24rpx;
  padding: 0 32rpx;
}

.attendance .grow {
  flex: 1;
}

.attendance-note {
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
}

.note-title {
  position: relative;
}

.note-text {
  padding: 28rpx 32rpx;
  font-size: 32rpx;
  white-space: pre-wrap;
}

.note-save {
  /* 44px tall tap area laid over the title, so showing it does not move the textarea. */
  position: absolute;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: var(--td-text-color-brand);
}

.history {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--td-component-stroke);
}

.history:first-child {
  border-top: none;
}

.history-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
}

.history-date {
  color: var(--td-text-color-primary);
}

.history-lesson {
  flex: 1;
  min-width: 0;
  color: var(--td-text-color-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-mark {
  font-size: 24rpx;
}

.mark-attended {
  color: var(--rs-success-text-color);
}

.mark-no_show {
  color: var(--rs-error-text-color);
}

.history-note {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--td-text-color-secondary);
}

.page-bottom {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.retry {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}

.feedback-note {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--rs-hint-color);
}

.feedback-write {
  padding: 0 32rpx;
}

.feedback-delete {
  color: var(--td-error-color);
}

.profile {
  padding: 28rpx 32rpx;
}

.profile-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.profile-note {
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--td-text-color-primary);
  white-space: pre-wrap;
  word-wrap: break-word;
}

.profile-empty {
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
}

.profile-chips + .profile-counts,
.profile-more + .profile-counts,
.profile-note + .profile-counts,
.profile-empty + .profile-counts {
  margin-top: 20rpx;
}

.profile-counts {
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
}

.profile-edited {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--td-text-color-placeholder);
}

.profile-feedback {
  margin-top: 16rpx;
}

/* A long note would push 签到 off the first screen. */
.profile-note-clamped {
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.profile-more {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  margin-bottom: -20rpx;
  font-size: 28rpx;
  color: var(--td-text-color-brand);
}

/* A long note wraps instead of squeezing the row label. */
.label {
  flex: none;
  white-space: nowrap;
}
