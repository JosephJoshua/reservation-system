@import '../../styles/common.wxss';

.status {
  display: flex;
  align-items: center;
  padding: 40rpx 48rpx 32rpx;
}

.status-text-block {
  flex: 1;
  min-width: 0;
}

.status-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-text {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
}

.attendance {
  display: flex;
  gap: 24rpx;
  padding: 0 32rpx;
}

.attendance .grow {
  flex: 1;
}

.attendance-note {
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
}

.note-title {
  position: relative;
}

.note-text {
  padding: 28rpx 32rpx;
  font-size: 32rpx;
  white-space: pre-wrap;
}

.note-save {
  /* 44px tall tap area laid over the title, so showing it does not move the textarea. */
  position: absolute;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: var(--td-text-color-brand);
}

.history {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--td-component-stroke);
}

.history:first-child {
  border-top: none;
}

.history-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
}

.history-date {
  color: var(--td-text-color-primary);
}

.history-lesson {
  flex: 1;
  min-width: 0;
  color: var(--td-text-color-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-mark {
  font-size: 24rpx;
}

.mark-attended {
  color: var(--rs-success-text-color);
}

.mark-no_show {
  color: var(--rs-error-text-color);
}

.history-note {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--td-text-color-secondary);
}

.page-bottom {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.retry {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}
