{
  "pages": [
    "pages/booking/index",
    "pages/lessons/index",
    "pages/profile/index",
    "pages/book/index",
    "pages/confirm/index",
    "pages/booking-detail/index",
    "pages/move/index",
    "pages/packages/index",
    "pages/my-packages/index",
    "pages/profile-edit/index",
    "pages/policy/index",
    "pages/coach-detail/index",
    "pages/account-delete/index",
    "pages/theme/index",
    "pages/invoices/index",
    "pages/invoice-request/index",
    "pages/feedback/index"
  ],
  "subpackages": [
    {
      "root": "coach",
      "name": "coach",
      "pages": [
        "index/index",
        "lesson/index",
        "session/index",
        "move/index",
        "feedback/index",
        "hours/index",
        "bind/index"
      ]
    }
  ],
  "usingComponents": {
    "privacy-popup": "/components/privacy-popup/index",
    "agree-check": "/components/agree-check/index",
    "theme-root": "/components/theme-root/index"
  },
  "window": {
    "navigationBarTitleText": "预约",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTextStyle",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTextStyle"
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/booking/index",
        "text": "预约",
        "iconPath": "@bookingIcon",
        "selectedIconPath": "@bookingIconActive"
      },
      {
        "pagePath": "pages/lessons/index",
        "text": "课程",
        "iconPath": "@lessonsIcon",
        "selectedIconPath": "@lessonsIconActive"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "@profileIcon",
        "selectedIconPath": "@profileIconActive"
      }
    ]
  },
  "darkmode": true,
  "themeLocation": "theme.json",
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json"
}
