/* The coach picker of the booking and move pages. */
.coach-scroll {
  white-space: nowrap;
}

.coach-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 32rpx;
}

.coach {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 152rpx;
  padding: 20rpx 0 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  background-color: var(--td-bg-color-secondarycontainer);
}

.coach-active {
  border-color: var(--td-brand-color);
  background-color: var(--td-brand-color-light);
}

.coach-name {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--td-text-color-primary);
}
