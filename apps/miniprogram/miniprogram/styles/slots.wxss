/* The time grid of the booking and move pages, and the bar that confirms a picked time. */
.slots-status {
  display: flex;
  justify-content: center;
  padding: 96rpx 32rpx;
  font-size: 28rpx;
  text-align: center;
}

.slots-empty {
  padding: 96rpx 0;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 0 32rpx;
}

.slot {
  padding: 20rpx 0;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  text-align: center;
  background-color: var(--td-bg-color-container);
}

.slot-hover {
  background-color: var(--td-bg-color-container-active);
}

.slot-picked {
  border-color: var(--td-brand-color);
  background-color: var(--td-brand-color-light);
}

.slot-time {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--td-text-color-primary);
}

.slot-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
}

/* The student's own seat in a group session: opens that booking. */
.slot-mine {
  border-color: var(--td-brand-color);
}

.slot-mine .slot-sub {
  color: var(--td-text-color-brand);
}

.slot-full {
  background-color: var(--td-bg-color-secondarycontainer);
}

.slot-full .slot-time,
.slot-full .slot-sub {
  color: var(--td-text-color-placeholder);
}

.picked {
  font-size: 28rpx;
}

.picked-text {
  color: var(--td-text-color-primary);
  font-weight: 500;
}

.picked-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
}

.retry {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}
